rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper Primitives (Phase 3)
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUserVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions for validating payloads (Phase 4 / Pillar 2)
    function isValidContact(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'countryId', 'countryName', 'createdAt'])
          && data.keys().size() <= 10
          && data.id is string && data.id.size() <= 128
          && data.userId is string && data.userId == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.countryId is string && data.countryId.size() <= 10
          && data.countryName is string && data.countryName.size() <= 100
          && data.createdAt is string && data.createdAt.size() <= 100
          && (!('city' in data) || (data.city is string && data.city.size() <= 100))
          && (!('contactInfo' in data) || (data.contactInfo is string && data.contactInfo.size() <= 200))
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
          && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 524288));
    }

    function isValidCountryColor(data) {
      return data.keys().hasAll(['userId', 'countryId', 'color'])
          && data.keys().size() == 3
          && data.userId is string && data.userId == request.auth.uid
          && data.countryId is string && data.countryId.size() <= 10
          && data.color is string && data.color.size() <= 50;
    }

    function isValidUserProfileSettings(data) {
      return data.keys().hasAll(['homeCountryId', 'geolocationEnabled', 'updatedAt'])
          && data.keys().size() == 3
          && data.homeCountryId is string && data.homeCountryId.size() <= 10
          && data.geolocationEnabled is bool
          && data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidPing(data) {
      return data.keys().hasAll(['id', 'fromUserId', 'fromUserName', 'toContactName', 'toContactId', 'createdAt', 'status'])
          && data.keys().size() == 7
          && data.id is string && data.id.size() <= 128
          && data.fromUserId is string && data.fromUserId == request.auth.uid
          && data.fromUserName is string && data.fromUserName.size() <= 100
          && data.toContactName is string && data.toContactName.size() <= 100
          && data.toContactId is string && data.toContactId.size() <= 128
          && data.createdAt is string && data.createdAt.size() <= 100
          && data.status is string && (data.status == 'unread' || data.status == 'read');
    }

    function isValidFriendActivity(data) {
      return data.keys().hasAll(['id', 'fromUserId', 'fromUserName', 'countryId', 'type', 'createdAt'])
          && data.keys().size() <= 11
          && data.id is string && data.id.size() <= 128
          && data.fromUserId is string && data.fromUserId == request.auth.uid
          && data.fromUserName is string && data.fromUserName.size() <= 100
          && data.countryId is string && data.countryId.size() <= 10
          && data.type is string && (data.type == 'added' || data.type == 'deleted')
          && data.createdAt is string && data.createdAt.size() <= 100
          && (!('toUserEmail' in data) || (data.toUserEmail is string && data.toUserEmail.size() <= 150))
          && (!('city' in data) || (data.city is string && data.city.size() <= 100))
          && (!('contactInfo' in data) || (data.contactInfo is string && data.contactInfo.size() <= 200))
          && (!('countryName' in data) || (data.countryName is string && data.countryName.size() <= 100))
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }


    // Contacts collection rules
    match /contacts/{contactId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Multi-User relational separation (Pillar 8)
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isUserVerified() && isValidId(contactId) && isValidContact(request.resource.data);
      
      allow update: if isUserVerified() && isValidId(contactId) && isValidContact(request.resource.data) 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
                     
      allow delete: if isUserVerified() && resource.data.userId == request.auth.uid;
    }

    // User colors subcollection rules
    match /users/{userId}/colors/{countryId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow create, update: if isUserVerified() && userId == request.auth.uid && isValidId(countryId) && isValidCountryColor(request.resource.data);
      
      allow delete: if isUserVerified() && userId == request.auth.uid;
    }

    // User settings subcollection rules (Resolves error 0)
    match /users/{userId}/settings/{settingsId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow create, update: if isUserVerified() && userId == request.auth.uid && isValidId(settingsId) && isValidUserProfileSettings(request.resource.data);
      
      allow delete: if isUserVerified() && userId == request.auth.uid;
    }

    // Global pings collection rules (Resolves error 1)
    match /pings/{pingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.status == 'unread';
      
      allow create: if isUserVerified() && isValidId(pingId) && isValidPing(request.resource.data);
      
      allow update: if isUserVerified() && isValidId(pingId) && isValidPing(request.resource.data)
                    && (resource.data.fromUserId == request.auth.uid || resource.data.toContactId == request.auth.uid);
                    
      allow delete: if false;
    }

    // Global friend_activities collection rules (for mutual friend additions / deletions notifications)
    match /friend_activities/{activityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isUserVerified() && isValidId(activityId) && isValidFriendActivity(request.resource.data);
      allow update, delete: if false;
    }
  }
}

